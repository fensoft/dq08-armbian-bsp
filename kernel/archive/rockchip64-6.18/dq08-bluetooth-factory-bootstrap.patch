@@ -102,6 +105,17 @@ properties:
        pcm-sync-mode: slave, master
        pcm-clock-mode: slave, master
 
+  brcm,dq08-startup-sequence:
+    type: boolean
+    description: |
+      Local Vontar DQ08 BSP opt-in. Hold BT_REG_ON low and drive HOST_WAKE
+      high for 40 ms, raise BT_REG_ON, keep HOST_WAKE high for another 20 ms,
+      return HOST_WAKE to input, then wait 150 ms before the first HCI command.
+      UART RTS remains muxed to the UART; hardware flow control is enabled
+      before HCI traffic. HCI starts at 115200 bit/s using the normal Broadcom
+      firmware setup. The default and host-wake-high pinctrl states must be
+      provided. This is a board quirk, not a BCM4335-wide requirement.
+
   brcm,requires-autobaud-mode:
     type: boolean
     description:
