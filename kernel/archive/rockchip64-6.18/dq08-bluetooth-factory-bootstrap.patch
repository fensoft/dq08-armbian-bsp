+    then:
+      properties:
+        pinctrl-names:
+          items:
+            - const: default
+            - const: host-wake-high
+      required:
+        - pinctrl-names
+        - pinctrl-0
+        - pinctrl-1
+        - shutdown-gpios
   - if:
       not:
         properties:
